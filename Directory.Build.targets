<Project>
  <ItemGroup Condition="'$(IsPackable)'=='true'">
    <!-- Repository files are not package content. Keep known local, policy, and
         non-package files out even if a future SDK or project glob marks them Pack. -->
    <None Remove="**/.env*;**/keelmatrix.telemetry.json;**/.fixturevault.json;**/.fixturevault.manifest.json;**/KeelMatrix.FixtureVault.md;**/.gitignore;**/NuGet.config;**/global.json;**/AGENTS.md;**/CHANGELOG.md;**/SECURITY.md;**/PRIVACY.md;**/*.csproj;**/*.sln;**/*.yml;**/*.yaml;**/Directory.*;**/*.nupkg;**/*.snupkg;**/*.trx;**/*.coverage;**/*.coveragexml;**/coverage*.xml;**/*.log;**/*.cache;**/*.zip;**/TestResults/**;**/artifacts/**;**/bin/**;**/obj/**" />
    <Content Remove="**/.env*;**/keelmatrix.telemetry.json;**/.fixturevault.json;**/.fixturevault.manifest.json;**/KeelMatrix.FixtureVault.md;**/.gitignore;**/NuGet.config;**/global.json;**/AGENTS.md;**/CHANGELOG.md;**/SECURITY.md;**/PRIVACY.md;**/*.csproj;**/*.sln;**/*.yml;**/*.yaml;**/Directory.*;**/*.nupkg;**/*.snupkg;**/*.trx;**/*.coverage;**/*.coveragexml;**/coverage*.xml;**/*.log;**/*.cache;**/*.zip;**/TestResults/**;**/artifacts/**;**/bin/**;**/obj/**" />
    <EmbeddedResource Remove="**/.env*;**/keelmatrix.telemetry.json;**/.fixturevault.json;**/.fixturevault.manifest.json;**/KeelMatrix.FixtureVault.md;**/.gitignore;**/NuGet.config;**/global.json;**/AGENTS.md;**/CHANGELOG.md;**/SECURITY.md;**/PRIVACY.md;**/*.csproj;**/*.sln;**/*.yml;**/*.yaml;**/Directory.*;**/*.nupkg;**/*.snupkg;**/*.trx;**/*.coverage;**/*.coveragexml;**/coverage*.xml;**/*.log;**/*.cache;**/*.zip;**/TestResults/**;**/artifacts/**;**/bin/**;**/obj/**" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath=""
          Link="README.md"
          Condition="Exists('$(MSBuildThisFileDirectory)README.md') and '$(PackageReadmeFile)'!=''" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath="LICENSE"
          Link="LICENSE"
          Condition="Exists('$(MSBuildThisFileDirectory)LICENSE') and '$(PackageLicenseExpression)'!=''" />
    <None Include="$(MSBuildThisFileDirectory)icon.png"
          Pack="true"
          PackagePath=""
          Link="icon.png"
          Condition="Exists('$(MSBuildThisFileDirectory)icon.png') and '$(PackageIcon)'!=''" />
  </ItemGroup>

  <!-- Remove protected files from all pack input item types using invariant,
       case-insensitive matching so Linux and macOS have the same safety
       boundary as Windows. -->
  <Target Name="ExcludeForbiddenFilesFromPack"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)'=='true'">
    <ItemGroup>
      <_ForbiddenPackItems Include="@(None);@(Content);@(EmbeddedResource)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_ForbiddenPackItems.Filename)', '(?i)^\.env')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_ForbiddenPackItems.Filename)%(_ForbiddenPackItems.Extension)', '(?i)^(keelmatrix\.telemetry\.json|\.fixturevault\.json|\.fixturevault\.manifest\.json|keelmatrix\.fixturevault\.md|\.gitignore|nuget\.config|global\.json|agents\.md|changelog\.md|security\.md|privacy\.md|directory\..*)$')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_ForbiddenPackItems.Filename)%(_ForbiddenPackItems.Extension)', '(?i)^coverage.*\.xml$')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_ForbiddenPackItems.Extension)', '(?i)^\.(csproj|sln|yml|yaml|nupkg|snupkg|trx|coverage|coveragexml|log|cache|zip)$'))" />
      <None Remove="@(_ForbiddenPackItems)" />
      <Content Remove="@(_ForbiddenPackItems)" />
      <EmbeddedResource Remove="@(_ForbiddenPackItems)" />
    </ItemGroup>
  </Target>

  <!-- Fail closed if a future pack glob or project item reintroduces a
       repository-local, policy, secret, or build file into _PackageFiles. -->
  <Target Name="RejectForbiddenFilesInPack"
          AfterTargets="_GetPackageFiles"
          Condition="'$(IsPackable)'=='true'">
    <ItemGroup>
      <_ForbiddenPackageFiles Include="@(_PackageFiles)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)', '(?i)^\.env')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)%(_PackageFiles.Extension)', '(?i)^(keelmatrix\.telemetry\.json|\.fixturevault\.json|\.fixturevault\.manifest\.json|keelmatrix\.fixturevault\.md|\.gitignore|nuget\.config|global\.json|agents\.md|changelog\.md|security\.md|privacy\.md|directory\..*)$')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)%(_PackageFiles.Extension)', '(?i)^coverage.*\.xml$')) Or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Extension)', '(?i)^\.(csproj|sln|yml|yaml|nupkg|snupkg|trx|coverage|coveragexml|log|cache|zip)$'))" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenPackageFiles)'!=''"
           Text="Refusing to pack forbidden repository file(s): @(_ForbiddenPackageFiles, ', ')." />
  </Target>
</Project>
