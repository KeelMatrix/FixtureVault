<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fixturevault</ToolCommandName>
    <PackageId>KeelMatrix.FixtureVault</PackageId>
    <PackageType>DotnetTool</PackageType>
    <Description>Audit snapshot and golden files for stale artifacts, leaked secrets, orphaned baselines, portability problems, and CI policy drift.</Description>
    <PackageTags>snapshot-testing;approval-testing;golden-files;test-fixtures;testing;ci;secrets;dotnet-tool</PackageTags>
    <PackageReleaseNotes>Read-only snapshot and golden-file governance with init-only policy file creation.</PackageReleaseNotes>
    <AssemblyName>KeelMatrix.FixtureVault</AssemblyName>
    <RootNamespace>KeelMatrix.FixtureVault</RootNamespace>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KeelMatrix.Redaction" />
    <PackageReference Include="KeelMatrix.Telemetry" />
  </ItemGroup>

  <PropertyGroup>
    <PackageOutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeelMatrix.FixtureVault.Tests" />
  </ItemGroup>

  <!-- PackAsTool suppresses dependencies by default; retain the public
       Redaction and Telemetry dependencies in the generated nuspec. -->
  <Target Name="EnableFixtureVaultPackageDependencies"
          BeforeTargets="_GetFrameworksWithSuppressedDependencies"
          Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    </PropertyGroup>
  </Target>
</Project>
