#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
temporary_file=$(mktemp "${TMPDIR:-/tmp}/commit-history.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
allowed_author_keelmatrix='KeelMatrix|keelmatrix@gmail.com'
allowed_author_dependabot='dependabot[bot]|49699333+dependabot[bot]@users.noreply.github.com'
allowed_committer_keelmatrix='KeelMatrix|keelmatrix@gmail.com'
allowed_committer_dependabot='dependabot[bot]|49699333+dependabot[bot]@users.noreply.github.com'
allowed_committer_github='GitHub|noreply@github.com'

if [ "$#" -eq 0 ]; then
  commits=$(git rev-list --all)
elif [ "$#" -eq 2 ]; then
  start=$1
  end=$2
  if [ -z "$start" ] || [ "$start" = '0000000000000000000000000000000000000000' ]; then
    commits=$(git rev-list "$end")
  else
    commits=$(git rev-list "$start..$end")
  fi
else
  printf '%s\n' 'History check expects zero arguments or a start and end revision.' >&2
  exit 2
fi

for commit in $commits; do
  identity=$(git show --no-patch --format='%an%n%ae%n%cn%n%ce' "$commit")
  old_ifs=$IFS
  IFS='
'
  set -- $identity
  IFS=$old_ifs
  author_name=$1
  author_email=$2
  committer_name=$3
  committer_email=$4
  author_identity="$author_name|$author_email"
  committer_identity="$committer_name|$committer_email"
  if [ "$author_identity" != "$allowed_author_keelmatrix" ] \
    && [ "$author_identity" != "$allowed_author_dependabot" ]; then
    printf 'History check failed at %s: author is not an approved KeelMatrix or Dependabot identity.\n' \
      "$commit" >&2
    exit 1
  fi
  if [ "$committer_identity" != "$allowed_committer_keelmatrix" ] \
    && [ "$committer_identity" != "$allowed_committer_dependabot" ] \
    && [ "$committer_identity" != "$allowed_committer_github" ]; then
    printf 'History check failed at %s: committer is not an approved KeelMatrix, Dependabot, or GitHub identity.\n' \
      "$commit" >&2
    exit 1
  fi

  git show --no-patch --format=%B "$commit" > "$temporary_file"
  if ! "$script_dir/commit-msg" "$temporary_file" >/dev/null; then
    printf 'History check failed at %s.\n' "$commit" >&2
    exit 1
  fi
done
