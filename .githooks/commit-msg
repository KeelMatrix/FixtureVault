#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  printf '%s\n' 'Commit message check could not read its input.' >&2
  exit 2
fi

# R1: configured internal reference prefixes.
internal_prefixes='KEE'
# R2: configured internal vocabulary words.
internal_vocabulary='paperclip codex chatgpt openai claude copilot gemini anthropic orchestration orchestrator'
# R3: configured identity and metadata trailer labels.
trailer_labels='co-authored-by signed-off-by reviewed-by tested-by acked-by reported-by approved-by agent model prompt'
# R4: configured review-process phrases.
# Keep this transport single-line: macOS awk rejects a literal newline in an
# awk -v assignment before it can evaluate the message policy.
review_phrases='frontier|review round|review pass|acceptance round|acceptance pass'
# R5: configured generated-attribution phrases.
generated_attributions='generated by'

message_file=$1

if decision=$(LC_ALL=C awk \
  -v prefixes="$internal_prefixes" \
  -v vocabulary="$internal_vocabulary" \
  -v labels="$trailer_labels" \
  -v reviews="$review_phrases" \
  -v generated="$generated_attributions" '
  function has_prefix(text, list, count, item, pattern) {
    count = split(list, configured, /[[:space:]]+/)
    for (item = 1; item <= count; item++) {
      if (configured[item] != "") {
        pattern = "(^|[^[:alnum:]])" tolower(configured[item]) "([0-9]|[^[:alnum:]]|$)"
        if (text ~ pattern) {
          return 1
        }
      }
    }
    return 0
  }
  function has_word(text, list, count, item, pattern) {
    count = split(list, configured, /[[:space:]]+/)
    for (item = 1; item <= count; item++) {
      if (configured[item] != "") {
        pattern = "(^|[^[:alnum:]])" tolower(configured[item]) "([^[:alnum:]]|$)"
        if (text ~ pattern) {
          return 1
        }
      }
    }
    return 0
  }
  function has_phrase(text, list, count, item, pattern) {
    count = split(list, configured, /[|]/)
    for (item = 1; item <= count; item++) {
      if (configured[item] != "") {
        pattern = "(^|[^[:alnum:]])" tolower(configured[item]) "([^[:alnum:]]|$)"
        if (text ~ pattern) {
          return 1
        }
      }
    }
    return 0
  }
  function is_trailer_line(text) {
    return text ~ /^[A-Za-z][A-Za-z-]*:/
  }
  function has_trailer(text, list, count, item, separator, name) {
    if (!is_trailer_line(text)) {
      return 0
    }
    separator = index(text, ":")
    name = tolower(substr(text, 1, separator - 1))
    count = split(list, configured, /[[:space:]]+/)
    for (item = 1; item <= count; item++) {
      if (name == configured[item]) {
        return 1
      }
    }
    return 0
  }
  {
    raw_message = raw_message $0 "\n"
    line = $0
    gsub(/[[:space:]]/, " ", line)
    gsub(/[^ -~]/, "|", line)
    normalized = normalized " " line
  }
  END {
    gsub(/ +/, " ", normalized)
    sub(/^ /, "", normalized)
    sub(/ $/, "", normalized)

    if (has_prefix(tolower(normalized), prefixes)) {
      exit 1
    }
    if (has_word(tolower(normalized), vocabulary)) {
      exit 2
    }

    gsub(/\r/, "\n", raw_message)
    line_count = split(raw_message, raw_line, /\n/)
    last = line_count
    while (last > 0 && raw_line[last] == "") {
      last--
    }
    first = last
    while (first > 1 && is_trailer_line(raw_line[first - 1])) {
      first--
    }
    if (is_trailer_line(raw_line[last])) {
      for (item = first; item <= last; item++) {
        if (has_trailer(raw_line[item], labels)) {
          exit 3
        }
      }
    }

    phrase_text = normalized
    gsub(/\|+/, " ", phrase_text)
    gsub(/[[:space:]]+/, " ", phrase_text)
    if (has_phrase(tolower(phrase_text), reviews)) {
      exit 4
    }
    if (has_phrase(tolower(phrase_text), generated)) {
      exit 5
    }
    exit 0
  }
' "$message_file"); then
  exit 0
else
  decision_status=$?
fi

case "$decision_status" in
  1) printf '%s\n' 'Commit message rejected: internal reference prefixes are not allowed.' >&2 ;;
  2) printf '%s\n' 'Commit message rejected: internal vocabulary is not allowed.' >&2 ;;
  3) printf '%s\n' 'Commit message rejected: identity or metadata trailers are not allowed.' >&2 ;;
  4) printf '%s\n' 'Commit message rejected: review-process wording is not allowed.' >&2 ;;
  5) printf '%s\n' 'Commit message rejected: generated attribution is not allowed.' >&2 ;;
  *) printf '%s\n' 'Commit message check could not evaluate its input.' >&2; exit 2 ;;
esac
exit 1
