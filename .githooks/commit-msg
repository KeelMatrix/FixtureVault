#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  printf '%s\n' 'Commit message check could not read its input.' >&2
  exit 2
fi

message_file=$1
normalized_file=$(mktemp "${TMPDIR:-/tmp}/fixturevault-commit-msg.XXXXXX")
trap 'rm -f "$normalized_file"' EXIT HUP INT TERM

# Rule B configuration. Add exact ASCII prefixes here, separated by spaces.
# The literal is required because this hook must enforce the repository's own
# reference vocabulary; the contract script reads this setting instead of
# duplicating it.
internal_prefixes='KEE'

# Normalize the complete message before any rule runs. ASCII whitespace is a
# layout boundary, Unicode whitespace is also a layout boundary, and other
# non-ASCII bytes/non-whitespace controls become visible separator markers.
# This prevents line breaks, NBSP, controls, and non-ASCII punctuation from
# hiding a continuation while leaving non-ASCII digit-only suffixes harmless.
nbsp=$(printf '\302\240')
ogham_space=$(printf '\341\232\200')
en_quad=$(printf '\342\200\200')
em_quad=$(printf '\342\200\201')
em_space=$(printf '\342\200\203')
three_per_em=$(printf '\342\200\204')
four_per_em=$(printf '\342\200\205')
six_per_em=$(printf '\342\200\206')
figure_space=$(printf '\342\200\207')
punctuation_space=$(printf '\342\200\210')
thin_space=$(printf '\342\200\211')
hair_space=$(printf '\342\200\212')
line_separator=$(printf '\342\200\250')
paragraph_separator=$(printf '\342\200\251')
narrow_nbsp=$(printf '\342\200\257')
medium_math_space=$(printf '\342\201\237')
ideographic_space=$(printf '\343\200\200')
arabic_indic_zero=$(printf '\331\240')
arabic_indic_one=$(printf '\331\241')
arabic_indic_two=$(printf '\331\242')
arabic_indic_three=$(printf '\331\243')
arabic_indic_four=$(printf '\331\244')
arabic_indic_five=$(printf '\331\245')
arabic_indic_six=$(printf '\331\246')
arabic_indic_seven=$(printf '\331\247')
arabic_indic_eight=$(printf '\331\250')
arabic_indic_nine=$(printf '\331\251')

LC_ALL=C tr '\011\012\013\014\015' '     ' < "$message_file" \
  | LC_ALL=C tr '\001-\010\016-\037\177' '|' \
  | LC_ALL=C sed \
      -e "s|$nbsp| |g" \
      -e "s|$ogham_space| |g" \
      -e "s|$en_quad| |g" \
      -e "s|$em_quad| |g" \
      -e "s|$em_space| |g" \
      -e "s|$three_per_em| |g" \
      -e "s|$four_per_em| |g" \
      -e "s|$six_per_em| |g" \
      -e "s|$figure_space| |g" \
      -e "s|$punctuation_space| |g" \
      -e "s|$thin_space| |g" \
      -e "s|$hair_space| |g" \
      -e "s|$line_separator| |g" \
      -e "s|$paragraph_separator| |g" \
      -e "s|$narrow_nbsp| |g" \
      -e "s|$medium_math_space| |g" \
      -e "s|$ideographic_space| |g" \
      -e "s|$arabic_indic_zero| |g" \
      -e "s|$arabic_indic_one| |g" \
      -e "s|$arabic_indic_two| |g" \
      -e "s|$arabic_indic_three| |g" \
      -e "s|$arabic_indic_four| |g" \
      -e "s|$arabic_indic_five| |g" \
      -e "s|$arabic_indic_six| |g" \
      -e "s|$arabic_indic_seven| |g" \
      -e "s|$arabic_indic_eight| |g" \
      -e "s|$arabic_indic_nine| |g" \
      -e 's/[^ -~]/|/g' \
  | LC_ALL=C tr -s ' ' \
  | LC_ALL=C sed -e 's/^ *//' -e 's/ *$//' > "$normalized_file"

# These words are intentionally plain: the hook is the executable policy that
# rejects internal metadata in commit messages, and obfuscating that policy is
# itself a hygiene failure.
label_co_author='co-authored-by'
label_signed_off='signed-off-by'
label_reviewed='reviewed-by'
label_tested='tested-by'
label_acked='acked-by'
label_reported='reported-by'
label_approved='approved-by'

if LC_ALL=C grep -Eiq "(^|[[:space:]])(${label_co_author}|${label_signed_off}|${label_reviewed}|${label_tested}|${label_acked}|${label_reported}|${label_approved})[[:space:]]*:" "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: identity trailers are not allowed.' >&2
  exit 1
fi

blocked_words='paperclip|codex|chatgpt|openai|claude|copilot|gemini|anthropic|orchestration|orchestrator'
if LC_ALL=C grep -Eiq "(^|[^[:alnum:]_])(${blocked_words})([^[:alnum:]_]|$)" "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: internal metadata is not allowed.' >&2
  exit 1
fi

if LC_ALL=C grep -Eiq '(^|[^[:alnum:]_])(agent|model|prompt)[[:space:]]*:' "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: internal metadata is not allowed.' >&2
  exit 1
fi

if LC_ALL=C grep -Eiq 'generated[[:space:]]+by' "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: generated attribution is not allowed.' >&2
  exit 1
fi

# Rule C — keyword-led references. The keyword and reference may use any
# normalized whitespace/punctuation layout; the prefix is deliberately
# prefix-agnostic and must contain ASCII letters followed by digits.
if LC_ALL=C awk '
  {
    text = tolower($0)
  }
  END {
    if (text ~ /(^|[^a-z])(refs|closes|fixes|resolves|reopens|issue|task|part[[:space:]]+of|related[[:space:]]+to)([^a-z]|$)[^a-z0-9]*[a-z][a-z0-9]*[[:space:]]*-[[:space:]]*[0-9]+/) {
      exit 0
    }
    exit 1
  }
' "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: keyword-led references are not allowed.' >&2
  exit 1
fi

# Rule D — review-process wording. Keep this vocabulary stable and match it
# after normalization so whitespace and line breaks cannot bypass the rule.
if LC_ALL=C grep -Eiq '(^|[^[:alnum:]_])(frontier|rejection[[:space:]]+round|review[[:space:]]+round|acceptance[[:space:]]+pass)([^[:alnum:]_]|$)' "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: review-process wording is not allowed.' >&2
  exit 1
fi

# Rules A and B operate on the same normalized stream:
#
# Rule A (separator-joined continuation, any token): reject every ASCII-letter
# token followed, through any whitespace/line-break layout, by a run that has
# a non-alphanumeric/non-whitespace separator and then ASCII digits. This is
# intentionally broader than the technical-token allowlist and closes generic
# forms such as `ABC` + LF + `_1` or `--3`.
#
# Rule B (internal prefixes, any layout): the configured prefixes above also
# reject an ASCII-digit continuation through whitespace alone. A generic token
# such as `AVX 512`, `ARM 64`, `CUDA 12`, `Go 1.22`, or `ABC 1` remains accepted.
# Complete allowlisted technical tokens remain accepted, including `UTF-8 1`
# and the historical Unicode code-point spelling `U+0000`.
# Non-ASCII digit suffixes remain accepted. The settled conservative rejects
# are `ISO-8601-1`, `IEEE-754-2019`, `SHA-256/384`, and `net8.0.1`.
if LC_ALL=C awk -v prefixes="$internal_prefixes" '
  function has_letter(value) { return value ~ /[A-Za-z]/ }
  function has_digit(value) { return value ~ /[0-9]/ }
  function has_separator_joined_digits(value) {
    return value ~ /^[A-Za-z][^[:space:]]*[^A-Za-z0-9[:space:]][^[:space:]]*[0-9]+/
  }
  function numeric_continuation(value) {
    return has_digit(value) && value !~ /[A-Za-z]/
  }
  function allowlisted(value) {
    return tolower(value) in technical
  }
  function allowlisted_or_terminal_punctuation(value, trimmed) {
    if (allowlisted(value)) {
      return 1
    }
    trimmed = value
    while (trimmed ~ /[^A-Za-z0-9]$/) {
      trimmed = substr(trimmed, 1, length(trimmed) - 1)
    }
    return trimmed != value && allowlisted(trimmed)
  }
  function violation() {
    exit 0
  }
  BEGIN {
    split(prefixes, configured, /[[:space:]]+/)
    for (key in configured) {
      if (configured[key] != "") {
        prefix[configured[key]] = 1
        prefix[tolower(configured[key])] = 1
      }
    }

    split("UTF-8 UTF-16 UTF-32 UTF-16LE UTF-16BE UTF-32LE UTF-32BE UTF-16/UTF-32 UTF-16LE/BE UTF-32LE/BE LATIN-1 SHA-1 SHA-256 SHA-384 SHA-512 MD5-5 HTTP-2 HTTP-3 TLS-1 TLS-1.2 TLS-1.3 SSL-3 RFC-9110 RFC-2119 ISO-8601 IEEE-754 ECMA-335 AES-256 AES-256-GCM HMAC-256 RSA-2048 MIME-1 CVE-2021-44228 net8.0 net10.0 NET-8 FV007 FV-E016 FV-SKIP-ENCODING U+0000", accepted, /[[:space:]]+/)
    for (key in accepted) {
      if (accepted[key] != "") {
        technical[tolower(accepted[key])] = 1
      }
    }
  }
  {
    stream = stream $0
  }
  END {
    count = split(stream, token, /[[:space:]]+/)

    # A complete non-allowlisted token matching the separator-plus-digit
    # shape is itself a separator-joined continuation. This deliberately does
    # not classify digit-led technical literals such as `0x00`.
    for (i = 1; i <= count; i++) {
      current = token[i]
      if (current == "") {
        continue
      }
      if (has_separator_joined_digits(current) && !allowlisted_or_terminal_punctuation(current)) {
        violation()
      }
    }

    for (i = 1; i <= count; i++) {
      current = token[i]
      if (current == "" || !has_letter(current)) {
        continue
      }

      lower_current = tolower(current)
      next_index = i + 1
      saw_separator = 0
      while (next_index <= count && token[next_index] != "") {
        following = token[next_index]

        if (following !~ /[A-Za-z0-9]/) {
          saw_separator = 1
          next_index++
          continue
        }

        if (saw_separator && numeric_continuation(following)) {
          violation()
        }

        if (saw_separator == 0 && following ~ /^[^A-Za-z0-9]/ && numeric_continuation(following)) {
          violation()
        }

        break
      }

      # Rule B is the only pure-whitespace generic-prefix exception.
      if (lower_current in prefix && next_index <= count && numeric_continuation(token[next_index])) {
        violation()
      }
    }

    exit 1
  }
' "$normalized_file"; then
  printf '%s\n' 'Commit message rejected: numeric continuation is not allowed.' >&2
  exit 1
fi
