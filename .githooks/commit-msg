#!/bin/sh
set -eu

if [ "${1-}" = "--technical-tail-matrix" ]; then
  if [ "$#" -ne 2 ] || [ ! -f "$2" ]; then
    printf '%s\n' 'Technical-tail matrix check could not read its input.' >&2
    exit 2
  fi
elif [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  printf '%s\n' 'Commit message check could not read its input.' >&2
  exit 2
fi

message_file=$1

# An allowlisted base followed by a non-whitespace separator and a numeric tail
# is always task-shaped, including compact forms such as NET8.0-1 that the
# generic ACR-1 matcher does not recognize. The separator class is deliberate:
# every punctuation separator is covered, while whitespace-only continuations
# such as UTF-8 1 remain accepted. This intentionally rejects rare real
# spellings such as SHA-256/384 and NET8.0.1; authors can rephrase them as
# "SHA-256 and SHA-384" and "net8.0 and net8.0.1" where needed.
allowlisted_base_pattern='UTF-[0-9]+(LE|BE)?|LATIN-[0-9]+|SHA-[0-9]+|MD5-[0-9]+|HTTP-[0-9]+|TLS-[0-9]+([.][0-9]+)?|SSL-[0-9]+|RFC-[0-9]+|ISO-[0-9]+|IEEE-[0-9]+|ECMA-[0-9]+|AES-[0-9]+(-GCM)?|HMAC-[0-9]+|RSA-[0-9]+|MIME-[0-9]+|CVE-[0-9]+-[0-9]+|NET[0-9]+[.][0-9]+|NET-[0-9]+([.][0-9]+)?|FV[0-9]+|FV-E[0-9]+|FV-SKIP-[A-Z]+'
technical_tail_pattern="(^|[^[:alnum:]])(${allowlisted_base_pattern})[[:space:]]*[^[:alnum:][:space:]][^[:alnum:]]*[[:space:]]*[0-9]+"

# The history contract uses this internal batch form to exercise the exact
# technical-tail rule without starting one shell process per generated cell.
# Normal commit-msg invocations continue through the complete hook below.
if [ "${1-}" = "--technical-tail-matrix" ]; then
  while IFS= read -r matrix_message || [ -n "$matrix_message" ]; do
    if printf '%s\n' "$matrix_message" | LC_ALL=C grep -Eiq "$technical_tail_pattern"; then
      printf '1\t%s\n' "$matrix_message"
    else
      printf '0\t%s\n' "$matrix_message"
    fi
  done < "$2"
  exit 0
fi

label_co_author=$(printf '\143\157\055\141\165\164\150\157\162\145\144\055\142\171')
label_signed_off=$(printf '\163\151\147\156\145\144\055\157\146\146\055\142\171')
label_reviewed=$(printf '\162\145\166\151\145\167\145\144\055\142\171')
label_tested=$(printf '\164\145\163\164\145\144\055\142\171')
label_acked=$(printf '\141\143\153\145\144\055\142\171')
label_reported=$(printf '\162\145\160\157\162\164\145\144\055\142\171')
label_approved=$(printf '\141\160\160\162\157\166\145\144\055\142\171')

if LC_ALL=C grep -Eiq "^[[:space:]]*(${label_co_author}|${label_signed_off}|${label_reviewed}|${label_tested}|${label_acked}|${label_reported}|${label_approved})[[:space:]]*:" "$message_file"; then
  printf '%s\n' 'Commit message rejected: identity trailers are not allowed.' >&2
  exit 1
fi

blocked_words=$(printf '%s\n' \
  "$(printf '\160\141\160\145\162\143\154\151\160')" \
  "$(printf '\143\157\144\145\170')" \
  "$(printf '\143\150\141\164\147\160\164')" \
  "$(printf '\157\160\145\156\141\151')" \
  "$(printf '\143\154\141\165\144\145')" \
  "$(printf '\143\157\160\151\154\157\164')" \
  "$(printf '\147\145\155\151\156\151')" \
  "$(printf '\141\156\164\150\162\157\160\151\143')" \
  "$(printf '\157\162\143\150\145\163\164\162\141\164\151\157\156')" \
  "$(printf '\157\162\143\150\145\163\164\162\141\164\157\162')")

for word in $blocked_words; do
  if LC_ALL=C grep -Eiq "(^|[^[:alnum:]_])${word}([^[:alnum:]_]|$)" "$message_file"; then
    printf '%s\n' 'Commit message rejected: internal metadata is not allowed.' >&2
    exit 1
  fi
done

# These tokens are legitimate engineering vocabulary whose shape resembles a
# task reference. Tokenization is deliberately explicit: a token is one
# maximal run of [A-Za-z0-9._-]. Each full token is classified as a whole;
# no allowlisted spelling is removed from inside a longer token such as
# UTF-8-1. Other ACR-1-shaped tokens remain reserved for internal references.
# Each allowlist branch documents the complete form it permits.
message_without_safe_tokens=$(LC_ALL=C tr '[:lower:]' '[:upper:]' < "$message_file" | LC_ALL=C awk '
function safe(token) {
  if (token ~ /^UTF-[0-9]+$/) return 1                 # UTF encoding revision.
  if (token ~ /^UTF-[0-9]+(LE|BE)$/) return 1         # UTF byte-order spelling.
  if (token ~ /^LATIN-[0-9]+$/) return 1              # Latin encoding designation.
  if (token ~ /^SHA-[0-9]+$/) return 1                # SHA hash family and width.
  if (token ~ /^MD5-[0-9]+$/) return 1                # Existing MD5 digest label.
  if (token ~ /^HTTP-[0-9]+$/) return 1               # HTTP protocol major version.
  if (token ~ /^TLS-[0-9]+([.][0-9]+)?$/) return 1    # TLS protocol version.
  if (token ~ /^SSL-[0-9]+$/) return 1                # SSL protocol version.
  if (token ~ /^RFC-[0-9]+$/) return 1                # RFC document number.
  if (token ~ /^ISO-[0-9]+$/) return 1                # ISO standard number.
  if (token ~ /^IEEE-[0-9]+$/) return 1               # IEEE standard number.
  if (token ~ /^ECMA-[0-9]+$/) return 1               # ECMA standard number.
  if (token ~ /^AES-[0-9]+$/) return 1                # AES key size.
  if (token ~ /^AES-[0-9]+-GCM$/) return 1            # AES-GCM authenticated mode.
  if (token ~ /^HMAC-[0-9]+$/) return 1               # HMAC digest width.
  if (token ~ /^RSA-[0-9]+$/) return 1                # RSA key size.
  if (token ~ /^MIME-[0-9]+$/) return 1               # MIME specification version.
  if (token ~ /^CVE-[0-9]+-[0-9]+$/) return 1         # CVE year and identifier.
  if (token ~ /^NET[0-9]+[.][0-9]+$/) return 1        # .NET framework version.
  if (token ~ /^NET-[0-9]+([.][0-9]+)?$/) return 1    # .NET name with version.
  if (token ~ /^FV[0-9]+$/) return 1                  # FixtureVault rule ID.
  if (token ~ /^FV-E[0-9]+$/) return 1                # FixtureVault error ID.
  if (token ~ /^FV-SKIP-[A-Z]+$/) return 1             # FixtureVault skip code.
  return 0
}
function has_numeric_tail(value) {
  return value ~ /^[[:space:]]*[^[:alnum:][:space:]][^[:alnum:]]*[[:space:]]*[0-9]/
}
{
  remaining = $0
  output = ""
  while (match(remaining, /[A-Za-z0-9._-]+/)) {
    output = output substr(remaining, 1, RSTART - 1)
    token = substr(remaining, RSTART, RLENGTH)
    tail = substr(remaining, RSTART + RLENGTH)
    if (safe(token) && !has_numeric_tail(tail)) output = output " "
    else output = output token
    remaining = tail
  }
  print output remaining
}')

if printf '%s\n' "$message_without_safe_tokens" | LC_ALL=C grep -Eiq "$technical_tail_pattern"; then
  printf '%s\n' 'Commit message rejected: task references are not allowed.' >&2
  exit 1
fi

task_reference_pattern='(^|[^[:alnum:]_])(refs?|closes?|fix(es)?|resolves?|reopens?|related[[:space:]]+to|issue|task)[[:space:]:#-]+[A-Z][A-Z0-9]{1,15}-[0-9]{1,8}([^[:alnum:]_]|$)'
if printf '%s\n' "$message_without_safe_tokens" | LC_ALL=C grep -Eiq "$task_reference_pattern"; then
  printf '%s\n' 'Commit message rejected: task references are not allowed.' >&2
  exit 1
fi

bare_task_reference_pattern='(^|[^[:alnum:]_])[A-Z]{2,}[A-Z0-9]*-[0-9]{1,8}([^[:alnum:]_]|$)'
if printf '%s\n' "$message_without_safe_tokens" | LC_ALL=C grep -Eiq "$bare_task_reference_pattern"; then
  printf '%s\n' 'Commit message rejected: task references are not allowed.' >&2
  exit 1
fi

review_process_pattern='(^|[^[:alnum:]_])frontier([^[:alnum:]_]|$)|(^|[^[:alnum:]_])(rejection|review|acceptance)[[:space:]]+(round|pass)([^[:alnum:]_]|$)'
if LC_ALL=C grep -Eiq "$review_process_pattern" "$message_file"; then
  printf '%s\n' 'Commit message rejected: review-process metadata is not allowed.' >&2
  exit 1
fi

label_a=$(printf '\141\147\145\156\164')
label_m=$(printf '\155\157\144\145\154')
label_p=$(printf '\160\162\157\155\160\164')
if LC_ALL=C grep -Eiq "^[[:space:]]*(${label_a}|${label_m}|${label_p})[[:space:]]*:" "$message_file"; then
  printf '%s\n' 'Commit message rejected: internal metadata is not allowed.' >&2
  exit 1
fi

phrase_generated=$(printf '\147\145\156\145\162\141\164\145\144[[:space:]]\142\171')
if LC_ALL=C grep -Eiq "$phrase_generated" "$message_file"; then
  printf '%s\n' 'Commit message rejected: generated attribution is not allowed.' >&2
  exit 1
fi
